# Návrh pro Infrastructure-netcup. Do toho repozitáře se nezapisuje.
#
# Cesta: VPS Traefik -> WireGuard wg1 -> domaPc 10.100.100.100.
# MikroTik DNAT v této cestě není, dokud nebude zapojení ověřené.
#
# Home Assistant: port 443, websecure, http://10.100.100.100:8123,
#   vlastní přihlášení, bez Authentik ForwardAuth.
# Zigbee2MQTT: port 8455, http://10.100.100.100:8080,
#   stávající Authentik-netcup, ForwardAuth, Embedded Outpost,
#   ip-whitelist a bezpečnostní middleware.
# ESPHome: port 8456, http://10.100.100.100:6052, stejná ochrana.
#
# Nový Authentik se nezakládá. authentik.yml se nemění.
# Prometheus zůstává na 8445 a jeho konfigurace se nemění.
# Statické entrypointy 8455 a 8456 se znovu nepřidávají.
# Dynamické routery používají jména zigbee2mqtt-domapc a esphome-domapc,
# protože tak se jmenují ve statickém traefik.yml.
# compose/10-traefik.yml tyto porty zatím nepublikuje.

--- a/configs/traefik/dynamic/homeassistant-domapc.yml
+++ b/configs/traefik/dynamic/homeassistant-domapc.yml
@@ -7,23 +7,23 @@
 #
 # Description:
 #   Central Traefik route to Home Assistant running on domaPc
-#   behind WireGuard wg2.
+#   behind WireGuard wg1.
 #
 # Backend:
 #
 #   Home Assistant
 #   Host:  domaPc
-#   IP:    10.110.100.100
+#   IP:    10.100.100.100
 #   Port:  8123
 #
 #   Traffic path:
 #
-#     VPS Traefik
-#       -> WireGuard wg2
-#       -> domaPc (10.110.100.100)
-#       -> MikroTik DNAT
-#       -> Incus container LAN IP
-#       -> Home Assistant Docker service
+#     VPS Traefik port 443, entrypoint websecure
+#       -> WireGuard wg1
+#       -> domaPc 10.100.100.100:8123
+#
+#   MikroTik DNAT is not part of this path until the
+#   physical wiring has been verified.
 #
 # Public hostname:
 #
@@ -95,7 +95,7 @@
         passHostHeader: true
 
         servers:
-          - url: "http://10.110.100.100:8123"
+          - url: "http://10.100.100.100:8123"
 
   ###########################################################################
   # Middleware

--- a/configs/traefik/dynamic/zigbeemqtt-domapc.yml
+++ b/configs/traefik/dynamic/zigbeemqtt-domapc.yml
@@ -11,14 +11,16 @@
 #
 # Access path:
 #
-#   WireGuard client
-#       -> VPS 10.100.100.1:8455
-#       -> Traefik entryPoint zigbee2mqtt :8455
-#       -> IP whitelist and security middleware
-#       -> Authentik ForwardAuth
-#       -> domaPc 10.110.100.100:8080
-#       -> MikroTik DNAT
-#       -> Incus container LAN IP:8080
+#   WireGuard wg1 client
+#       -> VPS Traefik entryPoint zigbee2mqtt-domapc :8455
+#       -> existing ip-whitelist and security middleware
+#       -> existing Authentik-netcup ForwardAuth
+#       -> existing Embedded Outpost
+#       -> domaPc 10.100.100.100:8080
+#
+#   Authentik-netcup is not changed and no new Authentik
+#   service is defined. MikroTik DNAT is not part of this
+#   path until the physical wiring has been verified.
 #
 # Client URL:
 #
@@ -56,7 +58,7 @@
 
     zigbeemqtt-domapc:
       entryPoints:
-        - zigbee2mqtt
+        - zigbee2mqtt-domapc
 
       rule: "PathPrefix(`/`)"
 
@@ -76,7 +78,7 @@
 
     zigbeemqtt-domapc-authentik-outpost:
       entryPoints:
-        - zigbee2mqtt
+        - zigbee2mqtt-domapc
 
       rule: "PathPrefix(`/outpost.goauthentik.io/`)"
 

--- a/configs/traefik/dynamic/esphome-domapc.yml
+++ b/configs/traefik/dynamic/esphome-domapc.yml
@@ -11,12 +11,16 @@
 #
 # Access path:
 #
-#   WireGuard client
-#       -> VPS 10.100.100.1:8456
-#       -> Traefik entryPoint esphome :8456
-#       -> IP whitelist and security middleware
-#       -> Authentik ForwardAuth
-#       -> domaPc 10.110.100.100:6052
+#   WireGuard wg1 client
+#       -> VPS Traefik entryPoint esphome-domapc :8456
+#       -> existing ip-whitelist and security middleware
+#       -> existing Authentik-netcup ForwardAuth
+#       -> existing Embedded Outpost
+#       -> domaPc 10.100.100.100:6052
+#
+#   Authentik-netcup is not changed and no new Authentik
+#   service is defined. MikroTik DNAT is not part of this
+#   path until the physical wiring has been verified.
 #
 # Client URL:
 #
@@ -54,7 +58,7 @@
 
     esphome-domapc:
       entryPoints:
-        - esphome
+        - esphome-domapc
 
       rule: "PathPrefix(`/`)"
 
@@ -74,7 +78,7 @@
 
     esphome-domapc-authentik-outpost:
       entryPoints:
-        - esphome
+        - esphome-domapc
 
       rule: "PathPrefix(`/outpost.goauthentik.io/`)"
 

--- a/compose/10-traefik.yml
+++ b/compose/10-traefik.yml
@@ -85,6 +85,8 @@
       - "10.10.10.10:8449:8449"
       - "10.10.10.10:8450:8450"
       - "10.10.10.10:8451:8451"
