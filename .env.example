###############################################################################
#
# HomeAssistant-domaPc
#
# Template for /docker-data/stacks/homeassistant-domapc/.env.
# Values that start with set_ are rejected by check-env.sh.
# Generated passwords are written only into the runtime .env.
# This file contains no real passwords, tokens or keys.
#
# Public TLS and access control stay on the VPS.
# HA_TRUSTED_PROXY is the address Home Assistant sees as the
# immediate client of the forwarded HTTP connection. With DNAT
# and without SNAT that is the VPS wg2 address 10.110.100.1.
# 10.100.100.100 is the physical host and is not this value.
#
###############################################################################

TZ=Europe/Prague
COMPOSE_PROJECT_NAME=homeassistant-domapc

DATA_DIR=/docker-data/homeassistant-domapc
HA_CONFIG_HOST_DIR=/docker-data/homeassistant-domapc/homeassistant
ZIGBEE2MQTT_HOST_DIR=/docker-data/homeassistant-domapc/zigbee2mqtt
ESPHOME_HOST_DIR=/docker-data/homeassistant-domapc/esphome
WMBUSMETERS_HOST_DIR=/docker-data/homeassistant-domapc/wmbusmeters
POSTGRESQL_HOST_DIR=/postgresql-data/homeassistant

HA_DOMAIN=homeassistant.serveftp.org

HA_IMAGE=ghcr.io/home-assistant/home-assistant
HA_TAG=2026.11.0
POSTGRES_IMAGE=docker.io/library/postgres:18.6
MOSQUITTO_IMAGE=docker.io/library/eclipse-mosquitto:2.1.2-alpine
ZIGBEE2MQTT_IMAGE=docker.io/koenkk/zigbee2mqtt:2.14.3
ESPHOME_IMAGE=docker.io/esphome/esphome:2026.8.1
WMBUSMETERS_IMAGE=docker.io/wmbusmeters/wmbusmeters:release-3.0.0

DOCKER_INTERNAL_SUBNET=172.31.0.0/24
DOCKER_INTERNAL_GATEWAY=172.31.0.1

PG_DB=homeassistant
PG_USER=homeassistant
PG_SUPER_PASS=set_postgres_superuser_password
PG_PASS=set_postgres_password

MQTT_USER=Zigbee2mqtt_domaPc
MQTT_PASSWORD=set_mqtt_password

ESPHOME_USERNAME=admin
ESPHOME_PASSWORD=set_esphome_password

HA_TRUSTED_PROXY=10.110.100.1

LOG_MAX_SIZE=20m
LOG_MAX_FILES=5

BACKUP_LOCAL_DIR=/docker-data/backups/homeassistant-domapc
BACKUP_EXTERNAL_DIR=

# Optional later copy. Leave both empty until the storage path is known.
# A path on the same disk as the application data is rejected.
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
RESTIC_KEEP_DAILY=7
RESTIC_KEEP_WEEKLY=4
RESTIC_KEEP_MONTHLY=6
RESTIC_KEEP_YEARLY=1

UPGRADE_MIN_FREE_MB=5120
